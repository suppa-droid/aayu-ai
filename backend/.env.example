# Copy this file to backend/.env on the lab PC.
# The GitHub zip does not contain backend/.env or any API key.
# Empty keys are allowed. Scheme scoring still works.
# Ask Aayu then returns the retrieved scheme text, and a real photo is not auto-approved.

GOOGLE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
DATABASE_URL=sqlite:///./aayu_ai.db
