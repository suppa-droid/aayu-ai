# Application Settings
PROJECT_NAME="VayoSetu"
VERSION="1.0.0"
ENVIRONMENT="development"

# FastAPI Backend Configuration
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="vayosetu-secret-key-change-in-production"

# Database Configuration (SQLite default for dev, PostgreSQL for prod)
DATABASE_URL="sqlite:///./vayosetu.db"
# DATABASE_URL="postgresql://vayosetu:vayosetu_pass@localhost:5432/vayosetu_db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# LLM & RAG Vector Store Config
OPENAI_API_API_KEY="your-openai-api-key-optional"
VECTOR_STORE_PATH="./chroma_db"

# WhatsApp Service (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Port Assignments
FIELD_DASHBOARD_PORT=3000
ADMIN_PANEL_PORT=3001
WHATSAPP_SERVICE_PORT=4000
VOICE_SERVICE_PORT=5000
